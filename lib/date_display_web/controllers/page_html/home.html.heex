<Layouts.flash_group flash={@flash} />

<main class="m-auto font-space-grotesk text-black">

  <section class="grid grid-cols-[auto_auto_auto_auto_auto] min-[1050px]:mb-5 [@media(max-height:430px)]:mt-10 ml-1.5 max-[690px]:ml-4">

    <div class="mb-auto">
      <.date_info info={@day} bottom />
      <.date_segment segment={@date} />
    </div>

    <.date_separator />

    <div>
      <.date_info info={@month_name} />
      <.date_segment segment={@month_numeric} />
      <.date_info info={@season} bottom />
    </div>

    <.date_separator />

    <div class="mt-auto">
      <.date_segment year segment={@year} />
      {leap_year_component(assigns)}
    </div>
  
  </section>

</main>
